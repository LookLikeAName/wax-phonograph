{
  "name": "wax-phonograph",
  "private": true,
  "version": "0.2.0",
  "description": "蠟筒留聲機：3D 類比刻錄物理模擬與播放器",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "music-metadata": "12.3.2",
    "three": "0.160.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4"
  },
  "build": {
    "appId": "io.github.looklikeaname.waxphonograph",
    "productName": "Wax Phonograph",
    "executableName": "WaxPhonograph",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/index.html",
      "electron/**",
      "build/icon.png",
      "build/tray.png",
      "build/tray@2x.png",
      "package.json"
    ],
    "win": {
      "target": [
        "zip",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "WaxPhonograph-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "WaxPhonograph-${version}-portable.exe"
    }
  }
}
