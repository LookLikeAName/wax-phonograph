{
  "name": "wax-phonograph",
  "private": true,
  "version": "0.1.0",
  "description": "蠟筒留聲機：3D 類比刻錄物理模擬與播放器",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4"
  },
  "build": {
    "appId": "io.github.looklikeaname.waxphonograph",
    "productName": "Wax Phonograph",
    "executableName": "WaxPhonograph",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/index.html", "electron/**", "build/icon.png", "build/tray.png", "build/tray@2x.png", "package.json"],
    "fileAssociations": [
      { "ext": "waxrack", "name": "WaxRack", "description": "蠟筒留聲機 蠟筒架檔案", "role": "Editor" }
    ],
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "蠟筒留聲機",
      "uninstallDisplayName": "蠟筒留聲機"
    }
  }
}
